# Copie para .streamlit/secrets.toml (local) OU cole em Settings → Secrets (Streamlit Cloud).
# As SENHAS de acesso NÃO ficam aqui — ficam na planilha:
#   - aba `participantes`, coluna `Senha` -> senha de cada participante (edita só o seu time)
#   - aba `config`, linha `senha_master`  -> senha do master (edita tudo + admin)
# Sem [gcp_service_account]/[gsheets] -> persistência local efêmera (some ao reiniciar) e,
# sem planilha, não há senhas cadastradas: o app fica somente-leitura.

[gsheets]
spreadsheet_key = "ID_DA_PLANILHA_NA_URL"
worksheet = "estado"

[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "conta@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
